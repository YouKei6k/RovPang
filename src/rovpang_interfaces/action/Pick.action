# 팀원 2 제공 : /rovpang/pick  (호출: 팀원 1 미션 관리 노드)
# Goal
geometry_msgs/PointStamped target   # 물품 위치. frame_id는 카메라 좌표계여도 됨(팀원 2가 TF로 변환)
string item_class
---
# Result
string REASON_OUT_OF_RANGE="OUT_OF_RANGE"   # 목표가 팔 작업 반경 밖: 다시 찾아도 소용없어 재시도하지 않음
bool success
string reason                       # 실패 사유, 성공 시 "". 반경 밖이면 OUT_OF_RANGE 로 시작
int32 attempts
---
# Feedback
string stage                        # "APPROACH", "GRASP", "LIFT" 등
